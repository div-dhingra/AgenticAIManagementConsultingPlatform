{
  "$defs": {
    "Domain": {
      "enum": [
        "technology",
        "clinical",
        "sec",
        "corporate_responsibility"
      ],
      "title": "Domain",
      "type": "string"
    },
    "DomainKnowledgeStatus": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "document_count": {
          "minimum": 0,
          "title": "Document Count",
          "type": "integer"
        },
        "chunk_count": {
          "minimum": 0,
          "title": "Chunk Count",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "document_count",
        "chunk_count",
        "warnings"
      ],
      "title": "DomainKnowledgeStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "live",
        "demo"
      ],
      "title": "Mode",
      "type": "string"
    },
    "domains": {
      "additionalProperties": {
        "$ref": "#/$defs/DomainKnowledgeStatus"
      },
      "propertyNames": {
        "$ref": "#/$defs/Domain"
      },
      "title": "Domains",
      "type": "object"
    }
  },
  "required": [
    "mode",
    "domains"
  ],
  "title": "KnowledgeStatus",
  "type": "object"
}
