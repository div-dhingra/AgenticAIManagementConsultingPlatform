{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "company": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Company"
        },
        "report_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Year"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "printed_page": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page"
        },
        "excerpt": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "title",
        "domain",
        "company",
        "report_year",
        "source_uri",
        "page",
        "printed_page",
        "excerpt"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ConsultRecommendation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "product",
            "component",
            "business_action",
            "diagnostic_action"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "supported",
            "conditional",
            "proposed"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "prerequisites": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "next_steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Next Steps",
          "type": "array"
        },
        "success_metrics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Success Metrics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rank",
        "kind",
        "title",
        "rationale",
        "priority",
        "assessment",
        "evidence_ids",
        "prerequisites",
        "next_steps",
        "success_metrics"
      ],
      "title": "ConsultRecommendation",
      "type": "object"
    },
    "Domain": {
      "enum": [
        "technology",
        "clinical",
        "sec",
        "corporate_responsibility"
      ],
      "title": "Domain",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "supported",
            "inference"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "domain",
        "statement",
        "assessment",
        "evidence_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "enum": [
            "route",
            "retrieve",
            "rank",
            "validate",
            "synthesize"
          ],
          "title": "Step",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Domain"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "completed",
            "skipped",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "step",
        "domain",
        "status",
        "detail"
      ],
      "title": "TraceEvent",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        },
        "reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "level",
        "reasons"
      ],
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "demo"
      ],
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "partial",
        "needs_clarification",
        "insufficient_evidence"
      ],
      "title": "Status",
      "type": "string"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/Domain"
      },
      "title": "Domains",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/ConsultRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "clarification_questions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Clarification Questions",
      "type": "array"
    },
    "uncertainty": {
      "$ref": "#/$defs/Uncertainty"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "title": "Trace",
      "type": "array"
    },
    "warnings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "mode",
    "status",
    "domains",
    "summary",
    "findings",
    "recommendations",
    "citations",
    "clarification_questions",
    "uncertainty",
    "trace",
    "warnings"
  ],
  "title": "ConsultResponse",
  "type": "object"
}
