{
  "$defs": {
    "Domain": {
      "enum": [
        "technology",
        "clinical",
        "sec",
        "corporate_responsibility"
      ],
      "title": "Domain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "company": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Company"
    },
    "report_year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Report Year"
    },
    "source_uri": {
      "minLength": 1,
      "title": "Source Uri",
      "type": "string"
    },
    "page": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Page"
    },
    "printed_page": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Printed Page"
    },
    "excerpt": {
      "maxLength": 400,
      "minLength": 1,
      "title": "Excerpt",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "document_id",
    "title",
    "domain",
    "company",
    "report_year",
    "source_uri",
    "page",
    "printed_page",
    "excerpt"
  ],
  "title": "Citation",
  "type": "object"
}
