# Copy to .env locally. Never put a real API key in Git or chat.
APP_MODE=live
LLM_PROVIDER=cohere
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Optional role overrides; empty values inherit COHERE_MODEL.
COHERE_ROUTER_MODEL=
COHERE_SPECIALIST_MODEL=
COHERE_SYNTHESIS_MODEL=
# Trial requests are paced across this service process, not across machines.
LLM_REQUESTS_PER_MINUTE=18
LLM_MAX_TOKENS=4000
# One bounded truncation retry may double this output budget, up to 8000.
CONSULT_TIMEOUT_SECONDS=90
LLM_TIMEOUT_SECONDS=30
MAX_LLM_CALLS=12
DATA_DIR=data
ARTIFACT_DIR=artifacts
# Optional API-only test source; requires live mode. Empty uses teammate 1's KB.
# Set to fixtures/consulting/controlled_real_passages.json to test through Streamlit.
# CONSULT_EVIDENCE_FILE=fixtures/consulting/controlled_real_passages.json
# Optional fallback provider selected explicitly, never automatically.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
